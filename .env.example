# Duitku — Environment Variables
# Salin file ini menjadi `.env.local` dan isi nilainya.
# JANGAN pernah commit secret/real value ke repository.

# ── Supabase ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_* aman dibundel ke client (anon key dirancang untuk publik).
# Ambil dari: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL absolut aplikasi (dipakai untuk redirect email confirmation).
# Diisi saat deployment (mis. https://duitku.vercel.app).
NEXT_PUBLIC_SITE_URL=
